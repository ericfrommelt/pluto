---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import efIcon from '../assets/EF-HeaderIcon.svg';
import efName from '../assets/ef-nameplate.svg';
---

<header class="flex items-center justify-between p-10">
	<div class="flex items-center space-x-4">
	<a href="/" class="flex items-center">
		<img src={efName.src} alt="Logo" width={169} height={64} data-lightbox-ignore />
	</a>
	</div>
	<nav>
	<ul class="flex space-x-4 text-md">
		<li><a href="/" class="hover:underline medium">Work</a></li>
		<li><a href="/info" class="hover:underline medium">Info</a></li>
	</ul>
	</nav>
</header>
