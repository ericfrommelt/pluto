---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Layout>
			<div class="container mx-auto p-8">

                <!-- crea.dev -->
                <div class="my-32">
                    <h2 class="text-2xl font-bold my-8">Visual identity for a technology event<br />
                    <span class="pantha-txt-light">crea.dev</span></h2>
                    <div class="grid grid-cols-1 gap-8 mb-8">
                        <Image class="rounded-md" src={cd04} width="5700" height="4000" alt="crea.dev website mockup"></Image>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                        <Image class="rounded-md" src={cd01} width="2625" height="2625" alt="crea.dev badge mockup"></Image>
                        <Image class="rounded-md" src={cd03} width="3200" height="3200" alt="crea.dev poster mockup"></Image>
                    </div>
                    <div class="grid grid-cols-1 gap-8 mb-8">
                        <Image class="rounded-md" src={cd02} width="2300" height="1440" alt="crea.dev brand guidelines"></Image>
                    </div>
                 </div>
                 
                <!-- dtv -->
                <div class="my-32">
                    <h2 class="text-2xl font-bold my-8">
                        In app purchase UX/UI + prototyping<br />
                        <span class="pantha-txt-light">Directv</span>
                    </h2>
                    <div class="grid grid-cols-1 gap-8 mb-8">
                        <Image class="rounded-md" src={dtv07} width="1920" height="1080" alt="dtv landing page"></Image>
                        <Image class="rounded-md" src={dtv08} width="1920" height="1080" alt="dtv user journey"></Image>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                        <!-- <Image class="rounded-md" src={dtv02} width="1920" height="1080" alt="step 2"></Image>
                        <Image class="rounded-md" src={dtv04} width="1920" height="1080" alt="step 4"></Image> -->
                        <Image class="rounded-md" src={dtv09} width="800" height="450" alt="Prototype"></Image>
                        <Image class="rounded-md" src={dtv01} width="1920" height="1080" alt="step 1"></Image>
                        <Image class="rounded-md" src={dtv06} width="1920" height="1080" alt="step 6"></Image>
                        <Image class="rounded-md" src={dtv05} width="1920" height="1080" alt="step 5"></Image>
                    </div>
                </div>

				 
				 <!-- hpe -->
				 <div class="my-32">
					 <h2 class="text-2xl font-bold my-8">
						 Landing pages and social content<br />
						 <span class="pantha-txt-light">Hewlett Packard Enterprise</span>
					 </h2>
					 <div class="grid grid-cols-1 gap-8 mb-8">
						 <Image class="rounded-md" src={hpe06} width="2676" height="1337" alt="hpe landing page"></Image>
						 <Image class="rounded-md" src={hpe07} width="2560" height="1440" alt="hpe social tiles"></Image>
					 </div>
					 <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
						 <div>
							 <Image class="rounded-md" src={hpe02} width="2560" height="4934" alt="cyber crime"></Image>
							 <Image class="rounded-md" src={hpe11} width="1920" height="1080" alt="animatic"></Image>
						 </div>
						 <Image class="rounded-md" src={hpe01} width="2560" height="7654" alt="cloud cliff"></Image>
					 </div>
				 </div>

				<!-- xlab -->
				<div class="my-32">
					<h2 class="text-2xl font-bold my-8">
						Brand explorations including bike paint, dealer catalog, and social concept<br />
                        <span class="pantha-txt-light">X-Lab</span>
                    </h2>
					<div class="grid grid-cols-1 gap-8 mb-8">
						<Image class="rounded-md" src={xlab01} width="1920" height="1080" alt="01"></Image>
						<Image class="rounded-md" src={xlab02} width="1920" height="1080" alt="02"></Image>
						<Image class="rounded-md" src={xlab03} width="1920" height="1080" alt="03"></Image>
						<Image class="rounded-md" src={xlab04} width="1920" height="1080" alt="04"></Image>

					</div>
				</div>


                <!-- Transformation -->
                <div class="my-32">
                    <h2 class="text-2xl font-bold my-8 mb-8">Transformation explainer video<br />
                        <span class="pantha-txt-light">Digitas</span></h2>
                    <div class="grid grid-cols-1 gap-8 mb-8">
                        <Vimeo id="https://vimeo.com/283314295?fl=tl&fe=ec">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                        <Image class="rounded-md" src={transformation01} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation02} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation03} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation04} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation05} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation06} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation07} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation08} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation09} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation10} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation11} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation12} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation13} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation14} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation15} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation16} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation17} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation18} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation19} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation20} width="3840" height="2160" alt="design frame"></Image>
                        <Image class="rounded-md" src={transformation21} width="3840" height="2160" alt="design frame"></Image>
                    </div>
                </div>

                <!-- GPUUU -->
                <div class="my-32">
                    <h2 class="text-2xl font-bold my-8">3D Exploration</h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                        <!-- <Image src={gpu01} width="2160" height="1215" alt="shapes on shapes on shapes"></Image> -->
                        <Image src={gpu02} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                        <Image src={gpu04} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                        <!-- <Image src={gpu05} width="2160" height="1215" alt="shapes on shapes on shapes"></Image> -->
                        <Image src={gpu07} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                        <!-- <Image src={gpu08} width="2160" height="1215" alt="shapes on shapes on shapes"></Image> -->
                        <Image src={gpu09} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                        <Image src={gpu11} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                        <Image src={gpu12} width="2160" height="1215" alt="shapes on shapes on shapes"></Image>
                    </div>
                </div>

                <!-- Specimen -->
                <div class="my-32">
                    <h2 class="text-2xl font-bold my-8">Specimen<br />
                        <span class="pantha-txt-light">Personal work</span>
                    <div class="grid grid-cols-1 gap-8 mb-8">
                        <Vimeo id="https://vimeo.com/15885998?fl=tl&fe=ec">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                        <Image src={specimen01} width="746" height="420" alt="design frame"></Image>
                        <Image src={specimen02} width="746" height="420" alt="design frame"></Image>
                        <Image src={specimen03} width="746" height="420" alt="design frame"></Image>
                    </div>
                </div>

				<!-- mtv -->
				<div class="my-32">
					<h2 class="text-2xl font-bold my-8">
						Book design<br />
						<span class="pantha-txt-light">MTV Press</span>
                    </h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
						<Image class="rounded-md" src={jackpot01} width="1170" height="777" alt="jackpot"></Image>
						<Image class="rounded-md" src={jackpot02} width="1170" height="777" alt="by Kevin Landers"></Image>
					</div>
					<div class="grid grid-cols-1 gap-8 mb-8">
						<Image class="rounded-md" src={jackpot03} width="1170" height="777" alt="spread"></Image>
						<Image class="rounded-md" src={jackpot04} width="1170" height="777" alt="spread"></Image>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
						<Image class="rounded-md" src={jackpot05} width="1170" height="777" alt="spread"></Image>
						<Image class="rounded-md" src={jackpot06} width="1170" height="777" alt="spread"></Image>
						<Image class="rounded-md" src={jackpot07} width="1170" height="777" alt="spread"></Image>
						<Image class="rounded-md" src={jackpot08} width="1170" height="777" alt="spread"></Image>
						<Image class="rounded-md" src={jackpot09} width="1170" height="777" alt="spread"></Image>
					</div>
				</div>
                
                <!-- Visions for Space -->
				<div class="my-32">
					<h2 class="text-2xl font-bold my-8">
						Visions for Space<br />
						<span class="pantha-txt-light">USC Viterbi School of Engineering</span>
                    </h2>
                    <div class="grid grid-cols-1 mb-8">
                        <Image class="rounded-md" src={spacevision02} width="2560" height="1759" alt=""></Image>
                    </div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                        <Image class="rounded-md" src={spacevision01} width="2560" height="1759" alt=""></Image>
						<Image class="rounded-md" src={spacevision03} width="2560" height="1759" alt=""></Image>
					</div>
                    <div class="grid grid-cols-1 mb-8">
                        <Image class="rounded-md" src={spacevision04} width="2560" height="1759" alt=""></Image>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 mb-8">
                        <Image class="rounded-md" src={spacevision05} width="1000" height="667" alt=""></Image>
                    </div>
				</div>
			</Layout>
	</body>
</html>
