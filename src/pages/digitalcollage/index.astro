					<Image src={imageThree} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageFour} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageSix} width="2048" height="2048" alt="Untitled"></Image>
					<!-- <Image src={imageSeven} width="2048" height="2048" alt="Untitled"></Image> -->
					<!-- <Image src={imageTen} width="2048" height="2048" alt="Untitled"></Image> -->
					<Image src={imageEleven} width="2048" height="2048" alt="Untitled"></Image>
				</div>
				<div class="grid grid-cols-1 gap-8 mt-8 mb-8">
					<Image src={imageNine} width="4096" height="1714" alt="Untitled"></Image>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
					<Image src={imageTwelve} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageThirteen} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageFourteen} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageFifteen} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageSixteen} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageSeventeen} width="2048" height="2048" alt="Untitled"></Image>
					<Image src={imageEighteen} width="2048" height="2048" alt="Untitled"></Image>
