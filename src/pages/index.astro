---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from "astro:assets";

import EFPortrait from '../assets/DSCF0051.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Layout>
    <main class="grid min-h-screen grid-cols-1 max-w-screen-md mx-auto p-4 gap-4">
        <div class="col-span-1">
			<div>
				<Image class="rounded-full" src={EFPortrait} width="200" height="200" alt="a portrait of Eric Frommelt"></Image>
			</div>
            <h1 class="text-5xl py-10 leading-16">Hello, I'm Eric</h1>
            <p class="mt-2">I'm a versatile visual designer with a penchant for storytelling and exploring new forms and technology.</p>
			<p class="mt-2">As an Illustrator, I've been commissioned by ESPN, Fast Company, Fortune, Forbes, IBM, Mtv, Ogilvy, Slack, and Wired.</p>
            <h6 class="font-bold mt-20">Commissions + Inquiries</h6>
            <h3 class="text-3xl"><a href="mailto:eric@ericfrommelt.com" class="hover:underline">eric@ericfrommelt.com</a></h3>

            <h3 class="pt-10"><span class="font-bold">Linkedin:</span> <a href="https://www.linkedin.com/in/ericfrommelt/" class="hover:underline">@ericfrommelt</a></h3>
            <h3><span class="font-bold">Instagram:</span> <a href="https://www.instagram.com/eric.frommelt/" class="hover:underline">@eric.frommelt</a></h3>
            <h3><span class="font-bold">Bluesky:</span> <a href="https://bsky.app/profile/ericfrommelt.bsky.social" class="hover:underline">@ericfrommelt</a></h3>
            <h3><span class="font-bold">Pinterest:</span> <a href="https://www.pinterest.com/ericfrommelt/_profile/" class="hover:underline">@ericfrommelt</a></h3>
        </div>
    </main>
</Layout>
	</body>
</html>
