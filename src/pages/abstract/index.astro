				<!-- +- -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
					<Image src={imageThirtyFour} width="1224" height="1584" alt="Untitled"></Image>
					<Image src={imageThirtyFive} width="1224" height="1584" alt="Untitled"></Image>
				</div>
				<!-- Untitled Panic -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-16">
					<Image src={untitledPanic01} alt="Untitled Panic 01" class="w-full h-auto" />
					<Image src={untitledPanic02} alt="Untitled Panic 02" class="w-full h-auto" />
