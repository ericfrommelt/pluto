---
import "../../styles/global.css";
import Layout from '../../layouts/Layout.astro';
import { Image } from "astro:assets";


import normiePortrait from '../../assets/DSCF0051.jpg';

---
<Layout>
    <main class="grid min-h-screen grid-cols-1 max-w-screen-md mx-auto p-4 gap-4">
        <div class="col-span-1">
            <div class="w-4/12">
                <Image src={normiePortrait} ="720" height="720" alt="Eric Frommelt Portrait"></Image>
            </div>
            <h1 class="text-3xl md:text-5xl py-10 md:leading-16">Eric Frommelt is a graphic designer + illustrator based in <nobr>Los Angeles,</nobr> California</h1>
            <h2>Select Clients</h2>
            <p>ESPN, Fast Company, Fortune, Forbes, IBM, Mtv, Ogilvy, Slack, Wired</p>
            <h6 class="font-bold mt-20">Commissions + Inquiries</h6>
            <h3 class="text-3xl"><a href="mailto:eric@ericfrommelt.com" class="hover:underline underline-offset-2">eric@ericfrommelt.com</a></h3>
        </div>
    </main>
</Layout>