				<div class="grid grid-cols-1 gap-8 mb-8">
					<MuxPlayer
					playbackId="dL1LKqb00NTuKioyY3maUY1HP7K8DpU72mGgT1Ff01D01U"
					metadata={{ video_title: 'YoshiGo by Eric Frommelt' }}
					style={{
						display: 'block',
						aspectRatio: '16/9',
						backgroundColor: '#000',
						margin: '1rem 0 2rem',
					}}
						primaryColor="#f2ec3a"
						secondaryColor="#0caa09"
						accentColor="#6e1e99"
						defaultShowRemainingTime={true}
						/>
					</div>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
						<MuxPlayer
						playbackId="a5ta2wI3L01b9oBXVGgEt76WSKctBOjcijqaGfpZfwIk"
