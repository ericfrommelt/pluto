<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Layout>
			<WorkNav />
			<div class="container mx-auto p-8">
			
				<!-- Untitled -->
				<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-2 xxl:grid-cols-2 gap-8 mb-8">
					<Image src={untitled72} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled73} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled74} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled67} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled68} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled70} width="2000" height="3000" alt="Untitled"></Image>
					<Image src={untitled71} width="2000" height="3000" alt="Untitled"></Image>
				</div>
				<div class="grid grid-cols-2 gap-8 mb-8">
