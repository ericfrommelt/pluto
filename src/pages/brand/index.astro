import cd01 from '../../assets/brand/creadev/CreaDev_Badge_Mockup_1.png';
import cd02 from '../../assets/brand/creadev/CreaDev_Guidelines.png';
import cd03 from '../../assets/brand/creadev/CreaDev_Poster_Mockup.png';
import cd04 from '../../assets/brand/creadev/CreaDev_Site_Mockup.png';

// jennair
import JennAir01 from '../../assets/brand/jennair/JennAir-01.png';
import JennAir02 from '../../assets/brand/jennair/JennAir-02.png';
import JennAir03 from '../../assets/brand/jennair/JennAir-03.png';
import JennAir04 from '../../assets/brand/jennair/JennAir-04.png';
import JennAir05 from '../../assets/brand/jennair/JennAir-05.png';
