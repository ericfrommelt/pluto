---
interface Props {
  id?: string;
  aspectRatio?: number;
  class?: string;
}

const { id = 'p5-canvas', aspectRatio, class: className } = Astro.props;
---

<div
  id={id}
  class:list={['p5-container', className]}
  data-aspect-ratio={aspectRatio}
></div>

<style>
  .p5-container {
    width: 100%;
  }
  .p5-container :global(canvas) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  import p5 from 'p5';

  document.querySelectorAll<HTMLDivElement>('[id^="p5-canvas"]').forEach((container) => {
    const ratio = container.dataset.aspectRatio ? parseFloat(container.dataset.aspectRatio) : 9 / 16;

    new p5((p: p5) => {
      p.setup = () => {
        const w = container.clientWidth;
        p.createCanvas(w, Math.round(w * ratio));
        p.background(99, 99, 12);
      };

      p.draw = () => {
        p.background(20, 10);
        p.noStroke();
        p.fill(255, 150, 255);
        const x = p.width / 2 + p.cos(p.frameCount * 0.02) * 100;
        const y = p.height / 2 + p.sin(p.frameCount * 0.03) * 100;
        p.ellipse(x, y, 20, 20);
      };

      p.windowResized = () => {
        const w = container.clientWidth;
        p.resizeCanvas(w, Math.round(w * ratio));
      };
    }, container);
  });
</script>
