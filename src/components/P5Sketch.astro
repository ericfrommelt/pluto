---
interface Props {
  id?: string;
  width?: number;
  height?: number;
  class?: string;
}

const { id = 'p5-canvas', width, height, class: className } = Astro.props;
---

<div
  id={id}
  class={className}
  data-width={width}
  data-height={height}
></div>

<script>
  import p5 from 'p5';

  document.querySelectorAll<HTMLDivElement>('[id^="p5-canvas"]').forEach((container) => {
    const w = container.dataset.width ? parseInt(container.dataset.width) : container.clientWidth;
    const h = container.dataset.height ? parseInt(container.dataset.height) : 400;

    new p5((p: p5) => {
      p.setup = () => {
        p.createCanvas(w, h);
        p.background(99,99,12);
      };

      p.draw = () => {
        p.background(20, 10);
        p.noStroke();
        p.fill(255, 150, 255);
        const x = p.width / 2 + p.cos(p.frameCount * 0.02) * 100;
        const y = p.height / 2 + p.sin(p.frameCount * 0.03) * 100;
        p.ellipse(x, y, 20, 20);
      };
    }, container);
  });
</script>
