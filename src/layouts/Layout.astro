---
import Analytics from '@vercel/analytics/astro'
import "../styles/global.css";
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_INTRO } from '../consts';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		{import.meta.env.PROD && (
			<>
				<!-- Google tag (gtag.js) -->
				<script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-0G9E31EKEE"></script>
				<script is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('js', new Date());

				gtag('config', 'G-0G9E31EKEE');
				</script>
			</>
		)}
	</head>
	<body class="bg-black text-neutral-100 flex flex-col min-h-screen">
		<Header />
		<slot />
		<Footer />
		<Lightbox />
		<Analytics />
	</body>
</html>